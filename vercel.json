{
  "framework": null,
  "buildCommand": "npm run build:backend",
  "outputDirectory": "backend-public",
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/transcribe", "destination": "/api/transcribe" },
    { "source": "/api/stt/status", "destination": "/api/health" },
    { "source": "/api/stt", "destination": "/api/transcribe" }
  ]
}

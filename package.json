{
  "name": "korean-stickman-voice-sandbox",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "node server.mjs --teacher-local",
    "dev:existing-stt": "node --env-file=../korean-stickman/.env server.mjs --teacher-local",
    "start:teacher-preview": "node server.mjs --teacher-preview",
    "test": "node --test tests/*.test.js",
    "build:backend": "node scripts/build-backend.mjs",
    "benchmark:language": "node scripts/benchmark-language.mjs",
    "teacher:server": "node teacher-service/server.mjs"
  }
}

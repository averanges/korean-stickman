# Copy to .env and set your key here. Never put it in src/ or send it to the browser.
GROQ_API_KEY=
STT_MODEL=whisper-large-v3
# PORT=5173

# Optional language interpreter (server only)
LLM_MODEL=openai/gpt-oss-20b
LLM_ENABLED=true
# LLM_API_KEY= (optional separate key; defaults to GROQ_API_KEY)

# STT 3.0.2 comparison uses the existing GROQ_API_KEY only.
# Each experiment variant pins its model and prompt; ordinary STT_MODEL is unchanged.

# Copy to .env and set your key here. Never put it in src/ or send it to the browser.
GROQ_API_KEY=
STT_MODEL=whisper-large-v3
# PORT=5173

# Optional language interpreter (server only)
LLM_MODEL=openai/gpt-oss-20b
LLM_ENABLED=true
# LLM_API_KEY= (optional separate key; defaults to GROQ_API_KEY)

# STT 3.0.2 experiment only; set OPENAI_API_KEY in Vercel, never in Pages or Amvera
OPENAI_API_KEY=
# Optional Groq B context: short Korean text, at most 224 UTF-8 bytes (conservative token bound)
# GROQ_STT_PROMPT=공책, 옷, 영화, 펜. 공책이 있어요. 옷을 사요. 영화를 봐요. 펜이 있어요.
